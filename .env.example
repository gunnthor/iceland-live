# Iceland Live — environment configuration
# All values are optional; sensible defaults are used when unset.

# Base URL for the Icelandic Meteorological Office public API gateway.
IMO_API_BASE_URL=https://api.vedur.is

# Pinned IMO API versions (sent as the `x-vi-api-version` request header).
# Pinning protects us from breaking upstream schema changes.
IMO_QUAKES_API_VERSION=2026-08-06
IMO_VOLCANOES_API_VERSION=2026-06-04

# Data source for earthquakes: "imo" (production) or "fixture" (offline UI development).
# `fixture` serves a checked-in snapshot and the UI labels itself as sample data.
# It is refused in production builds unless ALLOW_FIXTURES_IN_PRODUCTION=true.
EARTHQUAKE_SOURCE=imo
