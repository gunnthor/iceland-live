# Iceland Live — environment configuration
# Every value is optional; sensible defaults are used when unset, and the app
# needs no API keys of any kind.

# ---------------------------------------------------------------------------
# Icelandic Meteorological Office
# ---------------------------------------------------------------------------

# Base URL for IMO's public API gateway.
IMO_API_BASE_URL=https://api.vedur.is

# Pinned upstream API versions, sent as the `x-vi-api-version` header. IMO
# rejects an unknown value with HTTP 400, so a bad pin fails loudly at deploy
# time rather than silently shifting schema underneath us.
IMO_QUAKES_API_VERSION=2026-08-06
IMO_VOLCANOES_API_VERSION=2026-06-04
IMO_CAP_API_VERSION=2026-04-14
IMO_EPOS_API_VERSION=2026-02-05

# The dispersal service versions itself independently of EPOS and answers
# HTTP 415 — not 400 — to anything it does not recognise, including EPOS's own
# version string.
IMO_DISPERSION_API_VERSION=2025-08-13

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------

# "imo" (production) or "fixture" (offline UI development). `fixture` serves a
# checked-in snapshot of a real IMO response and the interface labels itself as
# sample data throughout. It is refused in production builds unless
# ALLOW_FIXTURES_IN_PRODUCTION is set explicitly.
EARTHQUAKE_SOURCE=imo
# ALLOW_FIXTURES_IN_PRODUCTION=true

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------

# Where to write the derived-data disk cache (currently the year of per-region
# earthquake counts that baselines compare against). Defaults to a directory
# under the system temp path.
#
# This is an accelerator, never storage: the app works identically when the
# path is unwritable. Point it at a persistent volume if you have one, which
# makes cold starts read ~90 KB of local JSON instead of re-fetching 5 MB.
#
# The camera frame store lives under this directory too. That one is not a
# cache of anything re-fetchable — once a camera publishes its next picture the
# previous one is gone upstream forever — so a persistent volume is worth more
# here than it is for the derived data.
# ICELAND_LIVE_CACHE_DIR=/var/cache/iceland-live

# Hard ceiling on the total size of recorded camera frames, in megabytes.
# Default 64, which is roughly 40 cameras × 30 frames at ~40 KB each. Over
# budget, the oldest frames are dropped from every reel rather than one camera
# being emptied, and no camera is ever left with no picture at all.
# ICELAND_LIVE_FRAME_BUDGET_MB=64

# ---------------------------------------------------------------------------
# Scheduled camera recording
# ---------------------------------------------------------------------------

# Frames only reach the store when something fetches them, and nobody has a
# camera open for the hour before something happens. Two ways to fix that,
# both calling the same function; pick whichever suits the deployment.

# 1. An external scheduler hitting GET /api/cron/cameras with this token as
#    `Authorization: Bearer <secret>` — the convention Vercel Cron sends.
#    With it unset the endpoint refuses in production and allows in
#    development, so a misconfigured deploy fails closed.
# CRON_SECRET=

# 2. An in-process timer, for deployments where the process outlives a request
#    (a VPS, a container). Meaningless on serverless, so it is opt-in.
# ICELAND_LIVE_CAMERA_RECORDER=1

# Seconds between ticks for the in-process recorder. Clamped to a minimum of
# 60: the cameras do not publish faster than that, and a tighter loop would
# only ask Vegagerdin for pictures we already hold.
# ICELAND_LIVE_CAMERA_RECORDER_SECONDS=120

# ---------------------------------------------------------------------------
# Durable frame storage (optional)
# ---------------------------------------------------------------------------

# Frames are the one thing here that cannot be fetched again: once a camera
# publishes its next picture the previous one is gone upstream forever. The
# default backend is the local filesystem under ICELAND_LIVE_CACHE_DIR, which
# is durable on a VPS or a container with a volume and is neither on
# serverless.
#
# Set all four of these to keep them in an S3-compatible object store instead
# (AWS S3, Cloudflare R2, Backblaze B2, MinIO). Partial configuration is
# treated as none, so a half-set deployment falls back to local rather than
# failing every write.
#
# Honest status: the signing is verified against AWS's own documented example
# and the operations against a local signature-checking server, but this has
# not been run against a live bucket.
# ICELAND_LIVE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# ICELAND_LIVE_S3_BUCKET=iceland-live
# ICELAND_LIVE_S3_ACCESS_KEY_ID=
# ICELAND_LIVE_S3_SECRET_ACCESS_KEY=

# "auto" suits R2 and several others; AWS needs the real region.
# ICELAND_LIVE_S3_REGION=auto

# Key prefix inside the bucket. Defaults to iceland-live/frames.
# ICELAND_LIVE_S3_PREFIX=iceland-live/frames

# How long frames are kept, in hours. Six suits a temporary directory, where
# nothing survives anyway; a longer window is the point of durable storage.
# ICELAND_LIVE_FRAME_RETENTION_HOURS=6

# How much of a frame must differ from the last one kept, as a fraction of its
# 8x8 blocks, for the new one to be worth a slot. A camera on an empty road
# publishes every minute whether or not anything happened.
#
# The default is a quarter of one percent, about a dozen blocks of a 640x480
# frame. Measured against live cameras: a still rural scene six minutes apart
# moved 0.02% of blocks, one vehicle crossing the view 1.75-2.6%, and busy
# traffic 24-36%. Set to 0 to keep every frame.
# ICELAND_LIVE_FRAME_CHANGE_THRESHOLD=0.0025
